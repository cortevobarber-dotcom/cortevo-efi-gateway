# ambiente Efí: prod ou hml
EFI_ENV=prod
# credenciais da aplicação Efí que tem a API Cobranças com cartão habilitada
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
# certificado da aplicação (caminho ou base64 do .crt/.key)
EFI_CERT_PATH=./certs/boletos.crt
EFI_KEY_PATH=./certs/boletos.key
# EFI_CERT_B64=
# EFI_KEY_B64=
# chave que o app envia no header x-api-key
GATEWAY_API_KEY=
# identificador de pagamento (payee code) usado pela tokenização no navegador
EFI_PAYEE_CODE=
# chave Pix da conta, usada pela rota /pix
EFI_PIX_KEY=
PORT=8080
